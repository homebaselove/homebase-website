{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wallet/chunk-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/funding.json",
      "destination": "/api/funding"
    },
    {
      "source": "/live.json",
      "destination": "/api/live"
    },
    {
      "source": "/live/preview.json",
      "destination": "/api/live-preview"
    },
    {
      "source": "/map.json",
      "destination": "/api/map"
    },
    {
      "source": "/map/preview.json",
      "destination": "/api/map-preview"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
