{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitAny": false,

    "paths": {
      "react": ["./node_modules/preact-uno/packages/preact/compat"],
      "react/jsx-runtime": [
        "./node_modules/preact-uno/packages/preact/jsx-runtime"
      ],
      "react-dom": ["./node_modules/preact-uno/packages/preact/compat"],
      "react-dom/*": ["./node_modules/preact-uno/packages/preact/compat/*"]
    },

    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [
          "effect",
          "@effect/platform"
        ]
      }
    ]
  }
}
